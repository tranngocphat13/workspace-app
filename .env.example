# ==============================================================================
# Supabase Environment Configuration Template
# ==============================================================================
# Copy this file to '.env.local' in the workspace-app directory:
#   cp .env.example .env.local
#
# NEXT_PUBLIC_ variables are exposed to the browser client in Next.js.
# Do NOT store Supabase service_role keys in this file.
# ==============================================================================

# 1. Supabase Project REST / API Endpoint URL
# Cloud: Found in your Supabase Dashboard under Project Settings > API > Project URL
# Local CLI: Defaults to http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anonymous (Public Client) Key
# Cloud: Found in your Supabase Dashboard under Project Settings > API > Project API Keys > anon / public
# Local CLI: Output by running `supabase status`
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ==============================================================================
# Offline Fallback Behavior
# ==============================================================================
# If these environment variables are left blank or omitted, workspace-app
# automatically enables safe offline mode. In offline mode, authentication and
# message persistence run locally via memory/localStorage to allow immediate demo
# evaluation and 100% test suite compatibility without a live Supabase server.
# ==============================================================================
